# Copy to `.env` (or export directly) and fill in real values.

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF-your-telegram-bot-token

# Comma-separated Telegram user IDs allowed to use the bot (find yours via @userinfobot)
ADMIN_IDS=123456789,987654321

# Comma-separated superadmin IDs. Superadmins can do everything admins can, plus
# reset the monthly money report (each reset is saved to history first).
SUPERADMIN_IDS=123456789

# Optional overrides
DB_PATH=bot.db
SPLIT_A_LABEL=Firma (60%)
SPLIT_B_LABEL=Xodim (40%)
